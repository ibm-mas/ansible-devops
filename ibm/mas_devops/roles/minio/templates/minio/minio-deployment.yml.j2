---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ minio_instance_name }}"
  namespace: "{{ minio_namespace }}"
spec:
  selector:
    matchLabels:
      app: "{{ minio_instance_name }}"
  template:
    metadata:
      labels:
        app: "{{ minio_instance_name }}"
        tag: "{{ minio_image_tag }}"
    spec:
      volumes:
        - name: storage
          persistentVolumeClaim:
            claimName: minio-pvc
      containers:
        - name: "{{ minio_instance_name }}"
          image: "{{ minio_image_registry }}/{{ minio_image_name}}@{{ minio_image_digest}}"
          command: ["minio"]
          args:
            - server
            - /data
            - --console-address
{% if ocp_enable_ipv6 is defined and ocp_enable_ipv6 | bool %}
            - "[::]:9090"
            - --address
            - "[::]:9000"
{% else %}
            - ":9090"
            - --address
            - ":9000"
{% endif %}
          env:
            - name: MINIO_ROOT_USER
              value: "{{ minio_root_user }}"
            - name: MINIO_ROOT_PASSWORD
              value: "{{ minio_root_password }}"
          volumeMounts:
            - mountPath: /data
              name: storage
