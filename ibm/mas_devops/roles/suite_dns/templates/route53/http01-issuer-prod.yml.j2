---
apiVersion: cert-manager.io/v1
kind: "{{ mas_issuer_kind }}"
metadata:
  name: "{{ route53_prod_issuer_name }}"
{% if mas_issuer_kind == 'Issuer' %}
  namespace: "{{ mas_namespace }}"
{% endif %}
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: "{{ route53_email }}"
    preferredChain: ''
    privateKeySecretRef:
      name: "{{ route53_prod_issuer_name }}"
    solvers:
    - http01:
        ingress:
          ingressClassName: "openshift-{{ mas_ingress_controller_name }}"
