---
# Secret referenced by spec.settings.db.attachmentProvider.secretName
# Stores the S3/COS secret access key for Manage attachment storage.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: "{{ mas_app_settings_attachment_provider_secret_name }}"
  namespace: "mas-{{ mas_instance_id }}-manage"
stringData:
  accessSecretKey: "{{ lookup('env', 'MAS_MANAGE_ATTACHMENTS_SECRET_ACCESS_KEY') }}"
