---
# Secret referenced by customizationList[].useS3.secretName
# Stores the S3/COS secret access key for downloading the customization archive.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: "{{ mas_app_settings_customization_archive_s3_secret_name }}"
  namespace: "mas-{{ mas_instance_id }}-manage"
stringData:
  accessSecretKey: "{{ lookup('env', 'MAS_APP_SETTINGS_CUSTOMIZATION_ARCHIVE_S3_SECRET_ACCESS_KEY') }}"
