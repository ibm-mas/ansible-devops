---
apiVersion: v1
kind: ConfigMap
metadata:
  name: "{{ mas_instance_id }}-{{ mas_workspace_id }}-{{ mas_app_id }}-attachments-configmap"
  namespace: "mas-{{ mas_instance_id }}-{{ mas_app_id }}"
  labels:
{% for key, value in (custom_labels | default({})).items() %}
    "{{ key }}": "{{ value }}"
{% endfor %}
data:
  mas_manage_attachments_provider: "{{ mas_manage_attachments_provider }}"
