---
apiVersion: operators.coreos.com/v1alpha1
kind: CatalogSource
metadata:
  name: ibm-operator-catalog
  namespace: openshift-marketplace
spec:
  displayName: IBM Maximo Operators ({{ mas_catalog_version }} Dev)
  publisher: IBM
  description: Catalog Source for IBM Maximo Application Suite (Internal Use Only)
  sourceType: grpc
  image: docker-na-public.artifactory.swg-devops.com/wiotp-docker-local/cpopen/ibm-maximo-operator-catalog:{{ mas_catalog_version }}
  # OLM-native pull secret injection (OCP 4.11+).
  # Secrets listed here are forwarded by OLM to every bundle-unpack Job/Pod it
  # spawns for this CatalogSource, regardless of the auto-generated SA name.
  # This replaces the Kyverno mutation approach used previously.
  secrets:
    - wiotp-docker-local
  updateStrategy:
    registryPoll:
      interval: 45m
  priority: 100
