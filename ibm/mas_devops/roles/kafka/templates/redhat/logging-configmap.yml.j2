apiVersion: v1
kind: ConfigMap
metadata:
  name: kafka-logging-config
  namespace: "{{ kafka_namespace }}"
data:
  kafka-log4j.properties: |
    # Log4j 2 configuration for Kafka 4.x.x
    rootLogger.level = INFO
    rootLogger.appenderRefs = stdout
    rootLogger.appenderRef.stdout.ref = STDOUT

    appender.stdout.type = Console
    appender.stdout.name = STDOUT
    appender.stdout.layout.type = PatternLayout
    appender.stdout.layout.pattern = [%d] %p %t %F:%L (%c) %m%n

    # General broker logging levels
    logger.kafka.name = kafka
    logger.kafka.level = INFO

    logger.org_apache_kafka.name = org.apache.kafka
    logger.org_apache_kafka.level = INFO

    # Request logger
    logger.kafka_request.name = kafka.request.logger
    logger.kafka_request.level = WARN
    logger.kafka_request.additivity = false
    logger.kafka_request.appenderRefs = stdout
    logger.kafka_request.appenderRef.stdout.ref = STDOUT

    # Controller logger
    logger.kafka_controller.name = kafka.controller
    logger.kafka_controller.level = TRACE
    logger.kafka_controller.additivity = false
    logger.kafka_controller.appenderRefs = stdout
    logger.kafka_controller.appenderRef.stdout.ref = STDOUT

    # Log cleaner logger
    logger.kafka_log_cleaner.name = kafka.log.LogCleaner
    logger.kafka_log_cleaner.level = INFO
    logger.kafka_log_cleaner.additivity = false
    logger.kafka_log_cleaner.appenderRefs = stdout
    logger.kafka_log_cleaner.appenderRef.stdout.ref = STDOUT

    # State change logger
    logger.state_change.name = state.change.logger
    logger.state_change.level = INFO
    logger.state_change.additivity = false
    logger.state_change.appenderRefs = stdout
    logger.state_change.appenderRef.stdout.ref = STDOUT

    # Authorizer logger
    logger.kafka_authorizer.name = kafka.authorizer.logger
    logger.kafka_authorizer.level = INFO
    logger.kafka_authorizer.additivity = false
    logger.kafka_authorizer.appenderRefs = stdout
    logger.kafka_authorizer.appenderRef.stdout.ref = STDOUT
