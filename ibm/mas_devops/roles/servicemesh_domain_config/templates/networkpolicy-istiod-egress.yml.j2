---
# Allow all pods in a mesh-enrolled namespace to reach istiod (port 15012) 
# The istio-proxy init container in EVERY
# injected pod needs this egress before it can pass its startup probe.
# Managing this centrally means no individual operator NetworkPolicy template
# needs to know about Istio internals — new workloads get it for free.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-istiod-egress
  namespace: "{{ targetNamespace }}"
spec:
  podSelector: {}
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
      ports:
        - protocol: TCP
          port: 15012
    - to:
        - namespaceSelector:
            matchLabels:
              istio-injection: enabled
      ports:
        - protocol: TCP
          port: 9443
  policyTypes:
    - Egress
