---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: "{{ _route_name }}"
  namespace: "{{ servicemesh_gateway_namespace }}"
spec:
  gateways:
    - "{{ _gateway_name }}"
  hosts:
    - "*"
  tls:
    - match:
        - port: "{{ _port_number }}"
          sniHosts:
            - "*"
      route:
        - destination:
            host: "{{ _service_name }}.{{ _service_namespace }}.svc.cluster.local"
            port:
              number: "{{ _port_number }}"
