---
apiVersion: v1
kind: Service
metadata:
  name: "{{ _gateway_name }}"
  namespace: "{{ servicemesh_gateway_namespace }}"
spec:
  type: ClusterIP
  selector:
    istio: "{{ _gateway_name }}"
  ports:
    - name: status-port
      port: 15021
      protocol: TCP
      targetPort: 15021
    - name: "{{ _target_port_name }}"
      port: {{ _port_number | int }}
      protocol: TCP
      targetPort: {{ _target_port_number | int }}
