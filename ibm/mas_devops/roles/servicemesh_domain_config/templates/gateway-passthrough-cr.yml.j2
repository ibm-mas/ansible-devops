---
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  name: "{{ _gateway_name }}"
  namespace: "{{ servicemesh_gateway_namespace }}"
spec:
  selector:
    istio: "{{ _gateway_name }}"
  servers:
    - hosts:
        - "*.{{ mas_domain }}"
      port:
        name: "{{ _target_port_name }}"
        number: {{ _port_number | int }}
        protocol: HTTPS
      tls:
        mode: PASSTHROUGH
