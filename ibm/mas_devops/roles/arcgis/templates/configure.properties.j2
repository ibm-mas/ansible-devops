# Configuration properties file for creating an ArcGIS Enterprise Organization.
# Auto-generated by the ansible-devops arcgis role — do not edit manually.

# ------------------------------------
# ARCHITECTURE PROFILE
# ------------------------------------
SYSTEM_ARCH_PROFILE="{{ arcgis_arch_profile }}"

# ------------------------------------
# SITENAME
# ------------------------------------
ARCGIS_SITENAME="{{ mas_arcgis_sitename }}"

# ------------------------------------
# ORGANIZATION PROPERTIES
# ------------------------------------
K8S_NAMESPACE="{{ mas_arcgis_namespace }}"

# ------------------------------------
# LICENSE PROPERTIES
# ------------------------------------
LICENSE_FILE="{{ arcgis_license_file }}"
LICENSE_TYPE_ID="{{ arcgis_license_type_id }}"

# ENCRYPTION_KEYFILE is not set — HELM_DEPLOY=true is passed at runtime
# which causes configure.sh to skip all AES-256 decryption checks and
# treat ADMIN_PASSWORD as a plaintext value directly.

# ------------------------------------
# ADMINISTRATOR ACCOUNT PROPERTIES
# ------------------------------------
ADMIN_USERNAME="{{ arcgis_admin_username }}"
ADMIN_PASSWORD="{{ arcgis_admin_password }}"
ADMIN_EMAIL="{{ arcgis_admin_email }}"
ADMIN_FIRST_NAME="{{ arcgis_admin_first_name }}"
ADMIN_LAST_NAME="{{ arcgis_admin_last_name }}"

# ------------------------------------
# SECURITY QUESTION
# ------------------------------------
SECURITY_QUESTION_INDEX={{ arcgis_security_question_index }}
SECURITY_QUESTION_ANSWER="{{ arcgis_security_question_answer }}"

# ------------------------------------
# CLOUD CONFIG JSON FILENAME (Optional)
# ------------------------------------
CLOUD_CONFIG_JSON_FILENAME=""

# ------------------------------------
# PLACEMENT POLICIES CONFIG FILENAME (Optional)
# ------------------------------------
PLACEMENT_POLICIES_CONFIG_FILENAME=""

# ------------------------------------
# LOG SETTINGS
# ------------------------------------
LOG_SETTING="{{ arcgis_log_setting }}"
LOG_RETENTION_MAX_DAYS={{ arcgis_log_retention_max_days }}

# ------------------------------------
# STORAGE PROPERTIES (DYNAMIC)
# ------------------------------------

# Relational Store
RELATIONAL_STORAGE_TYPE="DYNAMIC"
RELATIONAL_STORAGE_SIZE="{{ arcgis_storage_size_relational }}"
RELATIONAL_STORAGE_CLASS="{{ arcgis_storage_class }}"
RELATIONAL_STORAGE_LABEL_1=""
RELATIONAL_STORAGE_LABEL_2=""

# Object Store
OBJECT_STORAGE_TYPE="DYNAMIC"
OBJECT_STORAGE_SIZE="{{ arcgis_storage_size_object }}"
OBJECT_STORAGE_CLASS="{{ arcgis_storage_class }}"
OBJECT_STORAGE_LABEL_1=""
OBJECT_STORAGE_LABEL_2=""

# In-Memory Store
MEMORY_STORAGE_TYPE="DYNAMIC"
MEMORY_STORAGE_SIZE="{{ arcgis_storage_size_memory }}"
MEMORY_STORAGE_CLASS="{{ arcgis_storage_class }}"
MEMORY_STORAGE_LABEL_1=""
MEMORY_STORAGE_LABEL_2=""

# Queue Store
QUEUE_STORAGE_TYPE="DYNAMIC"
QUEUE_STORAGE_SIZE="{{ arcgis_storage_size_queue }}"
QUEUE_STORAGE_CLASS="{{ arcgis_storage_class }}"
QUEUE_STORAGE_LABEL_1=""
QUEUE_STORAGE_LABEL_2=""

# Spatiotemporal and Index Store
INDEXER_STORAGE_TYPE="DYNAMIC"
INDEXER_STORAGE_SIZE="{{ arcgis_storage_size_indexer }}"
INDEXER_STORAGE_CLASS="{{ arcgis_storage_class }}"
INDEXER_STORAGE_LABEL_1=""
INDEXER_STORAGE_LABEL_2=""

# Item Packages
SHARING_STORAGE_TYPE="DYNAMIC"
SHARING_STORAGE_SIZE="{{ arcgis_storage_size_sharing }}"
SHARING_STORAGE_CLASS="{{ arcgis_storage_class }}"
SHARING_STORAGE_LABEL_1=""
SHARING_STORAGE_LABEL_2=""

# Prometheus (metrics)
PROMETHEUS_STORAGE_TYPE="DYNAMIC"
PROMETHEUS_STORAGE_SIZE="{{ arcgis_storage_size_prometheus }}"
PROMETHEUS_STORAGE_CLASS="{{ arcgis_storage_class }}"
PROMETHEUS_STORAGE_LABEL_1=""
PROMETHEUS_STORAGE_LABEL_2=""
