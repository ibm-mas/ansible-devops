---
# OCP Route: exposes the manifest server so the ArcGIS Admin pod (running in a
# different namespace) can reach VERSION_MANIFEST_URL over HTTPS.
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: "{{ arcgis_manifest_route_name }}"
  namespace: "{{ mas_arcgis_namespace }}"
  labels:
    app: arcgis-manifest-server
    managed-by: ibm-mas-arcgis
spec:
  to:
    kind: Service
    name: "{{ arcgis_manifest_service_name }}"
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
